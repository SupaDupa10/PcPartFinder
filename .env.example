# ============================================================
# Local AI Hardware Deal Hunter - Umgebungsvariablen
# Kopiere diese Datei nach ".env" und passe die Werte an.
# .env wird NICHT in git eingecheckt (siehe .gitignore).
# ============================================================

# Diese Anwendung arbeitet bewusst ohne KI: Suchplan, Titelprüfung und
# Bewertung sind vollständig deterministisch (Schlagwörter und Regeln).
# Es gibt deshalb keine LLM-Einstellungen mehr.

# ------------------------------------------------------------
# eBay Browse API (offizielle, zulässige Schnittstelle)
# ------------------------------------------------------------
# Registrierung: https://developer.ebay.com/
# Benötigt wird ein "App ID" (Client ID) und "Client Secret" eines
# Production-Keysets. Der Browse-API-Scope für öffentliche Suchdaten ist
# "https://api.ebay.com/oauth/api_scope" (Application / client_credentials).
# Ohne diese Zugangsdaten bleibt der eBay-Connector deaktiviert und
# meldet dies ehrlich als Einschränkung.
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=
EBAY_MARKETPLACE_ID=EBAY_DE
EBAY_API_BASE=https://api.ebay.com
EBAY_MAX_RESULTS_PER_QUERY=400

# ------------------------------------------------------------
# eBay über die öffentliche Website (KEINE Zugangsdaten nötig)
# ------------------------------------------------------------
# Die Anwendung kann die normale eBay-Suche in einem echten Browser
# ausführen - so, wie du selbst im Browser suchst. Voraussetzung:
# "pip install playwright" und ein Browser (Standard: Google Chrome;
# EBAY_WEB_BROWSER wählt Chromium oder Firefox von Playwright). Es läuft ein
# echter Browser (kein Headless), weil eBay Headless-Browser und einfache HTTP-Abrufe mit
# HTTP 403 blockt - das Fenster bleibt aber unsichtbar (siehe EBAY_WEB_HIDDEN).
# Hinweis: Automatisiertes Auslesen ist von eBays Nutzungsbedingungen nicht
# ausdrücklich erlaubt. Abschalten mit EBAY_WEB_ENABLED=false.
EBAY_WEB_ENABLED=true
# Browser fuer die Website-Suche: auto (Google Chrome, sonst Chromium, sonst
# Firefox), chrome, chromium oder firefox. Chromium und Firefox stellt
# Playwright selbst bereit: 'playwright install chromium' bzw. 'playwright
# install firefox'. Das installierte Firefox kann Playwright nicht steuern.
EBAY_WEB_BROWSER=auto
EBAY_WEB_MAX_RESULTS_PER_QUERY=480
EBAY_WEB_TIMEOUT_SECONDS=45
# Treffer je Seite (60, 120 oder 240). Größere Seiten liefern dieselbe Liste in
# deutlich weniger Anfragen - das ist der größte Hebel für Tempo und Abdeckung.
# Liefert eBay kleiner als angefragt, richtet sich die Anwendung selbst danach
# aus (die nächste Seite schließt dann direkt an, es entsteht keine Lücke).
EBAY_WEB_PAGE_SIZE=240
# Gleichzeitige Abrufe. Der Mindestabstand (EBAY_WEB_MIN_DELAY_SECONDS) wird
# trotzdem eingehalten; die Wartezeit überlappt sich nur mit dem Laden der
# Seite, statt es zu blockieren. Höhere Werte bringen kaum mehr.
EBAY_WEB_MAX_CONCURRENCY=2
# Mindestabstand zwischen zwei Seitenaufrufen in Sekunden (Bot-Schutz).
EBAY_WEB_MIN_DELAY_SECONDS=1.5
# Persistentes Browser-Profil: echte Cookies senken den Bot-Verdacht. Bei
# Firefox kommt der Zusatz "-firefox" dazu (kein gemeinsames Profil).
EBAY_WEB_PROFILE_DIR=data/ebay_profile
# Browser nach dieser Ruhezeit schließen (0 = nie schließen).
EBAY_WEB_IDLE_SECONDS=180
# Zusätzliche Versuche nach einer Bot-Blockade (Pause + Startseite neu laden).
EBAY_WEB_BLOCK_RETRIES=2
# Kein sichtbares Fenster waehrend der Suche (Standard): Chrome startet mit
# einem echten, aber ausserhalb des Bildschirms liegenden und minimierten
# Fenster. Auf false stellen, wenn du die Suche im Browser verfolgen willst.
EBAY_WEB_HIDDEN=true
# Reines Headless (gar kein Fenster). eBay blockt das haeufig mit HTTP 403 -
# dann bleibt die Website-Suche leer. Standard bleibt deshalb false.
EBAY_WEB_HEADLESS=false
# Schnellverfahren (Standard): Die Trefferliste wird im bereits geoeffneten
# Tab per fetch geholt und ausgewertet, statt fuer jede Anfrage eine Seite
# aufzubauen. Das ist deutlich schneller (kein Rendern, kein Fenster- und
# Tab-Wechsel) und liefert dieselben Treffer. Auf false stellen, um wieder
# jede Seite vollstaendig zu laden (Vergleich/Fehlersuche).
EBAY_WEB_INLINE_FETCH=true

# ------------------------------------------------------------
# Kleinanzeigen
# ------------------------------------------------------------
# Kleinanzeigen stellt KEINE öffentliche API bereit. Der Connector
# "kleinanzeigen" bleibt deshalb bewusst deaktiviert und meldet eine
# dokumentierte Einschränkung statt Daten.
KLEINANZEIGEN_ENABLED=false

# Kleinanzeigen über die öffentliche Website (KEINE Zugangsdaten nötig)
# ------------------------------------------------------------
# Gleiches Vorgehen wie bei eBay (EBAY_WEB_*): Die App sucht die normale
# Kleinanzeigen-Seite in einem echten Browser - so, wie du selbst im Browser
# suchst. Voraussetzung: "pip install playwright" und ein Browser
# (Standard: Google Chrome; KLEINANZEIGEN_WEB_BROWSER wählt Chromium/Firefox).
# Hinweis: Automatisiertes Auslesen ist nach den Kleinanzeigen-
# Nutzungsbedingungen untersagt. Nutzung auf eigene Verantwortung, abschaltbar
# mit KLEINANZEIGEN_WEB_ENABLED=false.
KLEINANZEIGEN_WEB_ENABLED=true
# Browser fuer die Kleinanzeigen-Suche (siehe EBAY_WEB_BROWSER).
KLEINANZEIGEN_WEB_BROWSER=auto
# Obergrenze je Suchanfrage. Kleinanzeigen liefert fest 25 Treffer je Seite,
# 500 sind also 20 Seiten. Diese Zahl ist der wirksame Deckel dieser Quelle -
# fuer mehr Treffer hier erhoehen und SEARCH_MAX_PAGES_PER_QUERY mitziehen.
KLEINANZEIGEN_WEB_MAX_RESULTS_PER_QUERY=500
KLEINANZEIGEN_WEB_TIMEOUT_SECONDS=45
# Gleichzeitige Abrufe (siehe EBAY_WEB_MAX_CONCURRENCY). Kleinanzeigen liefert
# 25 Treffer je Seite; die Seiten werden parallel geholt, der Mindestabstand
# bleibt dabei erhalten.
KLEINANZEIGEN_WEB_MAX_CONCURRENCY=2
# Kleinanzeigen rendert die Ergebnisliste serverseitig -> kein sichtbares
# Fenster nötig. Bei Bedarf auf false stellen (öffnet ein Fenster).
KLEINANZEIGEN_WEB_HEADLESS=true
# Auch mit echtem (nicht-headless) Fenster bleibt es unsichtbar.
# Auf false stellen, um es zu sehen.
KLEINANZEIGEN_WEB_HIDDEN=true
# Eigenes Browser-Profil (ein Profil kann nur einmal gleichzeitig geöffnet sein).
KLEINANZEIGEN_WEB_PROFILE_DIR=data/kleinanzeigen_profile
# Mindestabstand zwischen zwei Seitenaufrufen in Sekunden (Bot-Schutz).
KLEINANZEIGEN_WEB_MIN_DELAY_SECONDS=1.5
# Browser nach dieser Ruhezeit schließen (0 = nie schließen).
KLEINANZEIGEN_WEB_IDLE_SECONDS=180
KLEINANZEIGEN_WEB_BLOCK_RETRIES=1
# Schnellverfahren wie bei eBay (EBAY_WEB_INLINE_FETCH).
KLEINANZEIGEN_WEB_INLINE_FETCH=true

# ------------------------------------------------------------
# Lokaler Import (Daten, die du selbst zulaessig beschafft hast)
# ------------------------------------------------------------
# Pfad zu einer JSON-Datei mit Angebotsdaten (eigener Export, manuelle
# Recherche, offizielle Partnerdatei). Leer = Connector nicht konfiguriert.
# Damit laeuft die komplette Pipeline ohne eBay-Zugangsdaten.
# Format: {"listings": [{title, url, price, ...}]} oder eine reine Liste.
LOCAL_IMPORT_PATH=

# ------------------------------------------------------------
# Kauf-Limit-Liste (wonach gesucht wird und bis wohin gekauft wird)
# ------------------------------------------------------------
# Handgepflegte Textdatei mit einer Komponente je Zeile:
#   NVIDIA GeForce RTX 3080 10GB = 270 €
# Die Oberflaeche sucht nach diesen Komponenten und zeigt nur Angebote bis zu
# ihrem jeweiligen Limit (inkl. Versand). Die Datei wird bei jeder Abfrage neu
# eingelesen - Aenderungen wirken sofort, ohne Neustart.
# Leer = keine Kauf-Limits (dann gilt die bisherige Suche nach Produktnamen).
PRICE_LIST_PATH=Höchstpreise.txt

# ------------------------------------------------------------
# Hardware-Wissensbasis
# ------------------------------------------------------------
# Standardordner mit hardware_knowledge.yaml. Wird beim Start geladen.
KNOWLEDGE_PATH=knowledge
# Optionaler zusaetzlicher Pfad zu einer eigenen Wissensdatei (YAML/JSON).
KNOWLEDGE_USER_FILE=

# ------------------------------------------------------------
# Server / Datenbank
# ------------------------------------------------------------
DATABASE_URL=sqlite:///./data/app.db
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
LOG_LEVEL=INFO

# ------------------------------------------------------------
# Suchlauf-Limits (steuern Abdeckung vs. Laufzeit/Limits)
# ------------------------------------------------------------
SEARCH_MAX_VARIANTS_PER_CATEGORY=12
SEARCH_MAX_PARALLEL_REQUESTS=4
# Seiten je Suchbegriff. Zusätzlich gilt die Obergrenze der Plattform
# (<PLATTFORM>_WEB_MAX_RESULTS_PER_QUERY je Seitengröße).
# Zwei Einheiten beachten: gezaehlt werden Seiten, nicht Treffer. Quellen mit
# kleinen Seiten (Kleinanzeigen: 25) brauchen mehr Seiten als solche mit
# großen (eBay-Website: 240). 20 deckt Kleinanzeigen vollstaendig ab.
SEARCH_MAX_PAGES_PER_QUERY=20
# Seiten, die gleichzeitig geholt werden. Nur wenn die Quelle ihre
# Gesamttrefferzahl meldet; sonst wird Seite für Seite vorgegangen, damit keine
# Anfrage für eine Seite verbraucht wird, die es nicht gibt.
SEARCH_PARALLEL_PAGES_PER_QUERY=3
# Anfragen je Lauf. Breite Suchbegriffe werden zusätzlich in einer zweiten
# Suchansicht (z. B. eBay "neueste zuerst") abgefragt - das braucht Platz.
SEARCH_MAX_QUERIES_PER_RUN=600
SEARCH_MAX_ROUNDS=2
# Zusaetzliche Detailabrufe pro Lauf fuer Angebote mit duenner Beschreibung.
SEARCH_MAX_DETAIL_FETCHES=8

# ------------------------------------------------------------
# Aufbewahrung
# ------------------------------------------------------------
# Angebote aelter als diese Anzahl Tage werden beim Aufraeumen entfernt.
RETENTION_DAYS=400
